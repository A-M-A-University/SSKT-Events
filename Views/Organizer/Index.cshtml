
@using SSKT_Events.Models

@{
    ViewData["Title"] = "Organizer";

    var organizer = (Organizer)ViewBag.Organizer;
    var suppliers = (List<Supplier>)ViewBag.Suppliers;
    var services = (List<SupplierService>)ViewBag.Services;
}

<h1>Organizer Home</h1>

<p>Logged in as: <strong>@organizer.Name</strong></p>

<hr />

<h4>Switch Organizer (Testing Only)</h4>

@foreach (var o in SSKT_Events.Controllers.OrganizerController.organizers)
{
    <a asp-action="Index" asp-route-organizerId="@o.Id">@o.Name</a>
    <span> | </span>
}

<hr />

<h4>Partner Suppliers</h4>

@if (!suppliers.Any())
{
    <p>No partner suppliers yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Supplier Name</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in suppliers)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.Email</td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

<h4>Services You Can Use in Packages</h4>

@if (!services.Any())
{
    <p>No services available.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Service</th>
                <th>Supplier</th>
                <th>Description</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in services)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@suppliers.FirstOrDefault(x => x.Id == s.SupplierId)?.Name</td>
                    <td>@s.Description</td>
                    <td>₱@s.Price.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
}