
@using SSKT_Events.Models

@{
    ViewData["Title"] = "Organizer Dashboard";

    var organizer = (Organizer)ViewBag.Organizer;
    var suppliers = (List<Supplier>)ViewBag.Suppliers;
    var services = (List<SupplierService>)ViewBag.Services;
}

<div class="container py-4">
    <!-- Welcome Section -->
    <div class="mb-4">
        <h4>Welcome, @organizer.Name!</h4>
        <p class="text-muted">
            Here's an overview of your event management activities.
        </p>
    </div>

    <!-- Dashboard Cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Events</h6>
                    <h3>@ViewBag.TotalEvents</h3>
                    <span class="text-muted small">Booked events</span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Packages</h6>
                    <h2 class="fw-bold">@ViewBag.TotalPackages</h2>
                    <span class="text-muted small">Created packages</span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Partner Suppliers</h6>
                    <h2 class="fw-bold">@ViewBag.TotalSuppliers</h2>
                    <span class="text-muted small">Connected suppliers</span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Available Services</h6>
                    <h2 class="fw-bold">@ViewBag.TotalServices</h2>
                    <span class="text-muted small">Active services</span>
                </div>
            </div>
        </div>

    </div>

    <!-- Partner Suppliers -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Partner Suppliers</h5>
        </div>

        <div class="card-body">
            @if (!suppliers.Any())
            {
                <p class="text-muted mb-0">No partner suppliers yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Supplier Name</th>
                                <th>Email</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in suppliers)
                            {
                                <tr>
                                    <td>@s.Name</td>
                                    <td>@s.Email</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Available Services -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Available Services</h5>
        </div>

        <div class="card-body">
            @if (!services.Any())
            {
                <p class="text-muted mb-0">No available services yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Service</th>
                                <th>Supplier</th>
                                <th>Description</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in services)
                            {
                                <tr>
                                    <td>@s.Name</td>
                                    <td>@(suppliers.FirstOrDefault(x => x.Id == s.SupplierId)?.Name ?? "Unknown")</td>
                                    <td>@s.Description</td>
                                    <td>₱@s.Price.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
</div>
