@using SSKT_Events.Models

@{
    ViewData["Title"] = "Customer Dashboard";

    var recentEvents = ViewBag.RecentEvents as List<EventRecord>
                       ?? new List<EventRecord>();
}

<div class="container py-4">

    <!-- Welcome Section -->
    <div class="mb-4">
        <h4>Welcome, @(ViewBag.CustomerName ?? "Client")!</h4>
        <p class="text-muted">
            Here's an overview of your events.
        </p>
    </div>

    <!-- Dashboard Cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Events</h6>
                    <h3>@(ViewBag.TotalEvents ?? 0)</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Upcoming Events</h6>
                    <h3>@(ViewBag.UpcomingEvents ?? 0)</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Pending Approval</h6>
                    <h3>@(ViewBag.PendingApproval ?? 0)</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Completed Events</h6>
                    <h3>@(ViewBag.CompletedEvents ?? 0)</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- Recent Events -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Recent Events</h5>
        </div>

        <div class="card-body">

            @if (!recentEvents.Any())
            {
                <p class="text-muted mb-0">No events to display yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Event Name</th>
                                <th>Date</th>
                                <th>Location</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in recentEvents)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.EventDate.ToString("MMM dd, yyyy")</td>
                                    <td>@item.Location</td>
                                    <td>@item.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>
