
@using SSKT_Events.Models

@{
    ViewData["Title"] = "Create Package";

    var organizer = (Organizer)ViewBag.Organizer;
    var suppliers = (List<Supplier>)ViewBag.Suppliers;
    var services = (List<SupplierService>)ViewBag.Services;
}

<h1>Create Package</h1>

<p>Logged in as: <strong>@organizer.Name</strong></p>

<hr />

@if (TempData["Error"] != null)
{
    <p class="text-danger">@TempData["Error"]</p>
}

<form asp-action="CreatePackage" method="post">
    <input type="hidden" name="organizerId" value="@organizer.Id" />

    <div class="form-group mb-3">
        <label class="control-label">Package Name</label>
        <input type="text" name="name" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label class="control-label">Description</label>
        <textarea name="description" class="form-control" rows="3"></textarea>
    </div>

    <div class="form-group mb-3">
        <label class="control-label">Included Services</label>

        @if (!services.Any())
        {
            <p>No services available from your partner suppliers yet.</p>
        }
        else
        {
            @foreach (var s in services)
            {
                <div>
                    <input type="checkbox"
                           name="serviceIds"
                           value="@s.Id"
                           id="service@(s.Id)" />

                    <label for="service@(s.Id)">
                        @s.Name -
                        @suppliers.FirstOrDefault(x => x.Id == s.SupplierId)?.Name,
                        ₱@s.Price.ToString("N2")
                    </label>
                </div>
            }
        }
    </div>

    <p>The package price is the total of the services you pick.</p>

    <div class="form-group">
        <input type="submit" value="Save Package" class="btn btn-primary" />
        <a asp-action="Packages"
           asp-route-organizerId="@organizer.Id">
            Cancel
        </a>
    </div>
</form>
