@model IEnumerable<SSKT_Events.Models.EventRecord>

@{
    ViewData["Title"] = "My Events";
}

<h1>My Events</h1>

<p>
    <a asp-action="Create">Create New Event</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ExpectedGuests)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalBudget)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody id="eventRows">
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Type)
                </td>
                <td>
                    @item.EventDate.ToString("MMM dd, yyyy")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Location)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ExpectedGuests)
                </td>
                <td>
                    ₱@item.TotalBudget.ToString("N2")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    |
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        // Runs whenever the user types in the search box
        document.getElementById("searchBox").addEventListener("input", function () {

            // Get the text entered by the user
            const text = this.value.toLowerCase();

            // Check every event row in the table
            document.querySelectorAll("#eventRows tr").forEach(function (row) {

                // Search the event name, type, date, location, guests, budget, and status
                const rowText = row.textContent.toLowerCase();

                // Display matching rows and hide non-matching rows
                row.style.display = rowText.includes(text) ? "" : "none";
            });
        });
    </script>
}