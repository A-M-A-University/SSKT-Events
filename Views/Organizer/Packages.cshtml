
@model List<SSKT_Events.Models.EventPackage>
@using SSKT_Events.Models

@{
    ViewData["Title"] = "My Packages";

    var organizer = (Organizer)ViewBag.Organizer;
    var services = (List<SupplierService>)ViewBag.Services;
}

<h1>My Packages</h1>

<p>
    <a asp-action="CreatePackage" asp-route-organizerId="@organizer.Id">
        Create Package
    </a>
</p>

<p>Logged in as: <strong>@organizer.Name</strong></p>

<hr />

<h4>Switch Organizer (Testing Only)</h4>

@foreach (var o in SSKT_Events.Controllers.OrganizerController.organizers)
{
    <a asp-action="Packages" asp-route-organizerId="@o.Id">@o.Name</a>
    <span> | </span>
}

<hr />

@if (!Model.Any())
{
    <p>You have no packages yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Package</th>
                <th>Description</th>
                <th>Included Services</th>
                <th>Price</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Description</td>
                    <td>
                        @string.Join(", ", services
                            .Where(s => p.ServiceIds.Contains(s.Id))
                            .Select(s => s.Name))
                    </td>
                    <td>₱@p.Price.ToString("N2")</td>
                    <td>
                        @if (p.IsPublished)
                        {
                            <span>Published</span>
                        }
                        else
                        {
                            <span>Draft</span>
                        }
                    </td>
                    <td>
                        <form asp-action="TogglePublish" method="post">
                            <input type="hidden" name="packageId" value="@p.Id" />
                            <input type="hidden" name="organizerId" value="@organizer.Id" />

                            <button type="submit">
                                @(p.IsPublished ? "Unpublish" : "Publish")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

<a asp-action="Index" asp-route-organizerId="@organizer.Id">Back</a>
