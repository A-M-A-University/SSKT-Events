
@using SSKT_Events.Models

@{
    ViewData["Title"] = "Book Services";

    var ev = (EventRecord)ViewBag.Event;
    var packages = (List<EventPackage>)ViewBag.Packages;
    var services = (List<SupplierService>)ViewBag.Services;
    var suppliers = (List<Supplier>)ViewBag.Suppliers;
    var allServices = SSKT_Events.Controllers.CatalogController.services;
}

<h1>Book Services</h1>

<h4>Event: @ev.Name</h4>

<p>
    Event Date: @ev.EventDate.ToString("MMMM dd, yyyy")
    <br />
    Total Budget: ₱@ev.TotalBudget.ToString("N2")
    <br />
    Remaining Budget: ₱@ev.RemainingBudget.ToString("N2")
</p>

<hr />

@if (TempData["Error"] != null)
{
    <p class="text-danger">@TempData["Error"]</p>
}

@if (TempData["Success"] != null)
{
    <p class="text-success">@TempData["Success"]</p>
}

<h4>Available Packages</h4>

@if (!packages.Any())
{
    <p>No packages are currently available.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Package</th>
                <th>Description</th>
                <th>Included Services</th>
                <th>Price</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in packages)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Description</td>
                    <td>
                        @string.Join(", ", allServices
                            .Where(s => p.ServiceIds.Contains(s.Id))
                            .Select(s => s.Name))
                    </td>
                    <td>₱@p.Price.ToString("N2")</td>
                    <td>
                        <form asp-action="BookPackage" method="post">
                            <input type="hidden" name="eventId" value="@ev.Id" />
                            <input type="hidden" name="packageId" value="@p.Id" />

                            <button type="submit" class="btn btn-primary">
                                Book Package
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

<h4>Individual Services</h4>

@if (!services.Any())
{
    <p>No individual services are currently available.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Service</th>
                <th>Supplier</th>
                <th>Description</th>
                <th>Price</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in services)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@suppliers.FirstOrDefault(x => x.Id == s.SupplierId)?.Name</td>
                    <td>@s.Description</td>
                    <td>₱@s.Price.ToString("N2")</td>
                    <td>
                        <form asp-action="BookService" method="post">
                            <input type="hidden" name="eventId" value="@ev.Id" />
                            <input type="hidden" name="serviceId" value="@s.Id" />

                            <button type="submit" class="btn btn-primary">
                                Book
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<hr />

<a asp-controller="Events"
   asp-action="Details"
   asp-route-id="@ev.Id">
    Back to Event
</a>
