@model SSKT_Events.Models.EventRecord

@{
    ViewData["Title"] = "Add Payment";
}

<h1>Add Payment</h1>

<h4>Payment Information</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">Event Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Outstanding Balance</dt>
    <dd class="col-sm-9">₱@Model.OutstandingBalance.ToString("N2")</dd>
</dl>

<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-action="AddPayment" method="post">

            <input type="hidden" name="eventId" value="@Model.Id" />

            <div class="form-group mb-3">
                <label for="amount" class="control-label">Amount (₱)</label>
                <input type="number" name="amount" id="amount"
                       step="0.01" min="0.01" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label for="dueDate" class="control-label">Due Date</label>
                <input type="date" name="dueDate" id="dueDate"
                       class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <input type="checkbox" name="isDownPayment"
                       value="true" id="isDownPayment" />
                <label for="isDownPayment">This is a down payment</label>
            </div>

            <div class="form-group mb-3">
                <input type="checkbox" name="markPaid"
                       value="true" id="markPaid" />
                <label for="markPaid">Mark as paid today</label>
            </div>

            <div class="form-group">
                <input type="submit" value="Save Payment" class="btn btn-primary" />
                <a asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            </div>

        </form>
    </div>
</div>