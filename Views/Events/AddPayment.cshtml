@model SSKT_Events.Models.EventRecord

@{
    ViewData["Title"] = "Pay via PayMongo";
}

<h1>Pay via PayMongo</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h4>Payment Summary</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">Event Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Total Booked Cost</dt>
    <dd class="col-sm-9">₱@Model.TotalBookedCost.ToString("N2")</dd>

    <dt class="col-sm-3">Total Paid</dt>
    <dd class="col-sm-9">₱@Model.TotalPaid.ToString("N2")</dd>

    <dt class="col-sm-3">Outstanding Balance</dt>
    <dd class="col-sm-9"><strong>₱@Model.OutstandingBalance.ToString("N2")</strong></dd>
</dl>

<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-action="AddPayment" method="post">
            <input type="hidden" name="eventId" value="@Model.Id" />

            <div class="form-group mb-3">
                <label for="amount" class="control-label">Amount to Pay (₱)</label>
                <div class="input-group">
                    <input type="number" name="amount" id="amount"
                           step="0.01" min="20.00"
                           max="@Model.OutstandingBalance"
                           value="@Model.OutstandingBalance.ToString("0.00")"
                           class="form-control" required />
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="document.getElementById('amount').value='@Model.OutstandingBalance.ToString("0.00")'">
                        Full Balance
                    </button>
                </div>
                <small class="text-muted">Minimum ₱20.00. You will be redirected to PayMongo's secure checkout page.</small>
            </div>

            <div class="form-group mb-3">
                <input type="checkbox" name="isDownPayment" value="true" id="isDownPayment" />
                <label for="isDownPayment">This is a down payment</label>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-success">
                    Pay with PayMongo
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
            </div>
        </form>
    </div>
</div>