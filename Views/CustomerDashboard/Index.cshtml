
@using SSKT_Events.Models

@{
    ViewData["Title"] = "Customer Dashboard";

    var recentEvents = ViewBag.RecentEvents as List<EventRecord>
                       ?? new List<EventRecord>();
}

<div style="background: #fff; color: #222; min-height: 100vh; padding: 32px;">

    <h2 style="font-weight: 600; margin-bottom: 8px;">
        Customer Dashboard
    </h2>

    <p style="color: #777; margin-bottom: 32px;">
        Welcome back, @(ViewBag.CustomerName ?? "Client")!
        Here's an overview of your events.
    </p>

    <!-- Event Statistics -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 32px;">

        <div style="border: 1px solid #e5e5e5; padding: 20px; border-radius: 8px;">
            <p style="color: #777; margin: 0;">Total Events</p>
            <h2 style="margin: 8px 0 0;">@(ViewBag.TotalEvents ?? 0)</h2>
        </div>

        <div style="border: 1px solid #e5e5e5; padding: 20px; border-radius: 8px;">
            <p style="color: #777; margin: 0;">Upcoming Events</p>
            <h2 style="margin: 8px 0 0;">@(ViewBag.UpcomingEvents ?? 0)</h2>
        </div>

        <div style="border: 1px solid #e5e5e5; padding: 20px; border-radius: 8px;">
            <p style="color: #777; margin: 0;">Pending Approval</p>
            <h2 style="margin: 8px 0 0;">@(ViewBag.PendingApproval ?? 0)</h2>
        </div>

        <div style="border: 1px solid #e5e5e5; padding: 20px; border-radius: 8px;">
            <p style="color: #777; margin: 0;">Completed Events</p>
            <h2 style="margin: 8px 0 0;">@(ViewBag.CompletedEvents ?? 0)</h2>
        </div>

    </div>

    <!-- Recent Events -->
    <div style="border: 1px solid #e5e5e5; border-radius: 8px; padding: 24px;">

        <h3 style="font-size: 18px; margin-bottom: 20px;">
            Recent Events
        </h3>

        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">

                <thead>
                    <tr style="border-bottom: 1px solid #e5e5e5; text-align: left;">
                        <th style="padding: 12px;">Event Name</th>
                        <th style="padding: 12px;">Date</th>
                        <th style="padding: 12px;">Location</th>
                        <th style="padding: 12px;">Status</th>
                    </tr>
                </thead>

                <tbody>
                    @if (recentEvents.Any())
                    {
                        foreach (var item in recentEvents)
                        {
                            <tr style="border-bottom: 1px solid #e5e5e5;">
                                <td style="padding: 12px;">@item.Name</td>
                                <td style="padding: 12px;">@item.EventDate.ToString("MMM dd, yyyy")</td>
                                <td style="padding: 12px;">@item.Location</td>
                                <td style="padding: 12px;">@item.Status</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="padding: 24px; text-align: center; color: #999;">
                                No events to display yet.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>
