<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SSKT_Events</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SSKT_Events.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    SSKT Events
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>

                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    var isCustomerArea = currentController == "CustomerDashboard" || currentController == "Events";
    var isSupplierArea = currentController == "Supplier";
    var isOrganizerArea = currentController == "Organizer";
}

@if (isCustomerArea || isSupplierArea || isOrganizerArea)
{
    <div class="container-fluid">
        <div class="row">

            <aside class="col-md-3 col-lg-2 border-end p-3">

                <h5>Dashboard Menu</h5>

                <nav class="nav flex-column mt-3">

                    @if (isCustomerArea)
                    {
                        <a asp-controller="CustomerDashboard" asp-action="Index" class="nav-link text-dark">
                            Dashboard
                        </a>

                        <a asp-controller="Events" asp-action="Index" class="nav-link text-dark">
                            My Events
                        </a>
                    }
                    else if (isSupplierArea)
                    {
                        <a asp-controller="Supplier" asp-action="Index" class="nav-link text-dark">
                            Dashboard
                        </a>

                        <a asp-controller="Supplier" asp-action="Services" class="nav-link text-dark">
                            My Services
                        </a>

                        <a asp-controller="Supplier" asp-action="Partnerships" class="nav-link text-dark">
                            Partnership Requests
                        </a>
                    }
                    else if (isOrganizerArea)
                    {
                        <a asp-controller="Organizer" asp-action="Index" class="nav-link text-dark">
                            Dashboard
                        </a>

                        <a asp-controller="Organizer" asp-action="Packages" class="nav-link text-dark">
                            Packages
                        </a>

                        <a asp-controller="Organizer" asp-action="Suppliers" class="nav-link text-dark">
                            Suppliers
                        </a>

                        <a asp-controller="Organizer" asp-action="CreatePackage" class="nav-link text-dark">
                            Create Package
                        </a>
                    }

                </nav>

            </aside>

            <main class="col-md-9 col-lg-10 p-4">
                @RenderBody()
            </main>

        </div>
    </div>
}
else
{
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
}


    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SSKT_Events -
            <a asp-controller="Home" asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
