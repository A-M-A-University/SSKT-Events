@model SSKT_Events.Models.EventRecord

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<h4>Event Record</h4>
<hr />

@if (TempData["Error"] != null)
{
    <p class="text-danger">@TempData["Error"]</p>
}

@if (TempData["Success"] != null)
{
    <p class="text-success">@TempData["Success"]</p>
}

<div>
    <h5>Event Information</h5>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Event Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Event Type</dt>
        <dd class="col-sm-9">@Model.Type</dd>

        <dt class="col-sm-3">Event Date</dt>
        <dd class="col-sm-9">@Model.EventDate.ToString("MMMM dd, yyyy")</dd>

        <dt class="col-sm-3">Start Time</dt>
        <dd class="col-sm-9">@Model.StartTime.ToString(@"hh\:mm")</dd>

        <dt class="col-sm-3">End Time</dt>
        <dd class="col-sm-9">@Model.EndTime.ToString(@"hh\:mm")</dd>

        <dt class="col-sm-3">Location</dt>
        <dd class="col-sm-9">@Model.Location</dd>

        <dt class="col-sm-3">Expected Guests</dt>
        <dd class="col-sm-9">@Model.ExpectedGuests</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Special Requirements</dt>
        <dd class="col-sm-9">@Model.SpecialRequirements</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <h5>Budget Summary</h5>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Total Budget</dt>
        <dd class="col-sm-9">₱@Model.TotalBudget.ToString("N2")</dd>

        <dt class="col-sm-3">Booked Services</dt>
        <dd class="col-sm-9">₱@Model.TotalBookedCost.ToString("N2")</dd>

        <dt class="col-sm-3">Remaining Budget</dt>
        <dd class="col-sm-9">₱@Model.RemainingBudget.ToString("N2")</dd>

        <dt class="col-sm-3">Budget Used</dt>
        <dd class="col-sm-9">@Model.BudgetUsedPercent.ToString("0")%</dd>
    </dl>

    @if (Model.IsOverBudget)
    {
        <p class="text-danger">Warning: Event budget exceeded!</p>
    }

    <h5>Supplier Bookings</h5>
    <hr />

    @if (!Model.Bookings.Any())
    {
        <p>No bookings yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Price</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Bookings)
                {
                    <tr>
                        <td>@b.ServiceName @(b.IsFromPackage ? "(package)" : "")</td>
                        <td>@b.BookingDate.ToString("MMM dd, yyyy")</td>
                        <td>@b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm")</td>
                        <td>₱@b.Price.ToString("N2")</td>
                        <td>@b.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h5>Payment Summary</h5>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Total Paid</dt>
        <dd class="col-sm-9">₱@Model.TotalPaid.ToString("N2")</dd>

        <dt class="col-sm-3">Outstanding Balance</dt>
        <dd class="col-sm-9">₱@Model.OutstandingBalance.ToString("N2")</dd>
    </dl>

    @if (Model.Status != SSKT_Events.Models.EventStatus.Cancelled)
    {
        @if (Model.HasConfirmedBookings)
        {
            <a asp-action="AddPayment" asp-route-id="@Model.Id">Add Payment</a>
        }
        else
        {
            <p>Payments open once a supplier accepts a booking.</p>
        }
    }

    @if (Model.Payments.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Due Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Payments)
                {
                    <tr>
                        <td>@(p.IsDownPayment ? "Down payment" : "Payment")</td>
                        <td>@p.DueDate.ToString("MMM dd, yyyy")</td>
                        <td>₱@p.Amount.ToString("N2")</td>
                        <td>@(p.IsPaid ? "Paid" : p.IsOverdue ? "Overdue" : "Unpaid")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<hr />

<div>
    <a asp-action="Index">Back to Events</a>

    @if (Model.Status != SSKT_Events.Models.EventStatus.Cancelled)
    {
        <span> | </span>
        <a asp-action="Edit" asp-route-id="@Model.Id">Edit Event</a>

        <span> | </span>
        <a asp-action="Cancel" asp-route-id="@Model.Id">Cancel Event</a>

        <span> | </span>
        <a asp-controller="Catalog"
           asp-action="Index"
           asp-route-eventId="@Model.Id">Browse & Book</a>
    }
    else
    {
        <p class="text-danger">
            Cancelled on @Model.CancelledAt?.ToString("MMM dd, yyyy")
            @(string.IsNullOrWhiteSpace(Model.CancellationReason)
                ? ""
                : "- " + Model.CancellationReason)
        </p>
    }
</div>